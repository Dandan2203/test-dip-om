# --- HTTP-сервер ---
APP_PORT=8080

# --- PostgreSQL ---
# Параметри відповідають docker-compose.yml (порт 5433 проброшено на 5432).
DATABASE_URL=postgres://finagent_user:finagent_secret@localhost:5433/finagent?sslmode=disable

# --- Автентифікація ---
# Для промислового середовища замініть на довгий випадковий рядок.
JWT_SECRET=change-me-to-a-long-random-secret

# --- Python AI-мікросервіс ---
AI_SERVICE_URL=http://localhost:8000

# --- Шифрування секретів у БД (токен Monobank тощо) ---
# У проді замініть на довгий випадковий рядок. Зміна ключа зробить наявні секрети нечитними.
ENCRYPTION_KEY=change-me-to-a-long-random-secret
